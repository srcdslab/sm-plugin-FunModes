#include "em_modules/nuke.sp"
#include "em_modules/gas.sp"
#include "em_modules/radiation.sp"
#include "em_modules/acid.sp"
#include "em_modules/cold.sp"
#include "em_modules/darkness.sp"
#include "em_modules/gravity.sp"
#include "em_modules/ice.sp"
#include "em_modules/wind.sp"
#include "em_modules/tornado.sp"
#include "em_modules/quicksand.sp"
#include "em_modules/magnet.sp"
#include "em_modules/halluc.sp"
#include "em_modules/leech.sp"
#include "em_modules/jam.sp"
#include "em_modules/butter.sp"
#include "em_modules/frenzy.sp"
#include "em_modules/doublejump.sp"
#include "em_modules/physics.sp"   // stacks the speed changes of Boss, Hero, Last Stand
#include "em_modules/roulette.sp"   // switches the others on and off
#include "em_modules/settings.sp"   // generated by gen_settings.py: every menu setting, saved and loaded

public Plugin myinfo =
{
	name = "Event Modes",
	author = "DynamicFog",
	description = "VIP, Heal Beacon, Random Weapons, Gun Game, Hot Potato, Buddy System, Lightning, Math Quiz, Red Light Green Light, Simon Says, Event Roulette and Fog in one admin menu",
	version = PLUGIN_VERSION,
	url = ""
};

public void OnPluginStart()
{
	Integrations_PluginStart();
	Fog_PluginStart();
	Modes_PluginStart();
	RW_PluginStart();
	GG_PluginStart();
	Potato_PluginStart();
	Buddy_PluginStart();
	MQ_PluginStart();
	RLGL_PluginStart();
	Simon_PluginStart();
	IC_PluginStart();
	BZ_PluginStart();
	Hero_PluginStart();
	FL_PluginStart();
	TV_PluginStart();
	NK_PluginStart();
	AR_PluginStart();
	FC_PluginStart();
	WG_PluginStart();
	LC_PluginStart();
}

public void OnMapStart()
{
	Fog_MapStart();
	Modes_MapStart();
	RW_MapStart();
	Potato_MapStart();
	Lightning_MapStart();
	BO_MapStart();
	TV_MapStart();
	HS_MapStart();
	HL_MapStart();
	RLGL_MapStart();
}

public void OnMapEnd()
{
	Settings_Save();
	Fog_MapEnd();
	Modes_MapEnd();
	RW_MapEnd();
}

public void OnClientPutInServer(int client)
{
	Modes_ClientPutInServer(client);
	RW_ClientPutInServer(client);
	GG_ClientPutInServer(client);
	Potato_ClientPutInServer(client);
	MQ_ClientPutInServer(client);
}

public Action OnPlayerRunCmd(int client, int &buttons, int &impulse, float vel[3], float angles[3], int &weapon,
	int &subtype, int &cmdnum, int &tickcount, int &seed, int mouse[2])
{
	Potato_RunCmd(client, buttons);
	Simon_RunCmd(client, buttons);
	DJ_RunCmd(client, buttons);
	bool changed = IC_RunCmd(client, buttons, vel);
	if (JG_RunCmd(client, buttons))
		changed = true;
	return changed ? Plugin_Changed : Plugin_Continue;
}

// Chat goes to the modes that read answers from it, one after the other.
public Action OnClientSayCommand(int client, const char[] command, const char[] sArgs)
{
	Action result = MQ_Say(client, sArgs);
	if (result == Plugin_Continue)
		result = TV_Say(client, sArgs);
	return result;
}

// Plugin unloaded: put back what lives outside the round (fog, sv_friction, sm_force_shake).
public void OnPluginEnd()
{
	Settings_Save();
	Fog_PluginEnd();
	IF_Freeze(false);
	EQ_ForceShake(false);
	ZMarket_Sync(false);
}

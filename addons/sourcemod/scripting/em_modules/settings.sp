bool Settings_Load()
{
	char path[PLATFORM_MAX_PATH];
	BuildPath(Path_SM, path, sizeof(path), SETTINGS_FILE);
	KeyValues kv = new KeyValues("EventModes");
	if (!kv.ImportFromFile(path))
	{
		delete kv;
		return false;
	}
	if (kv.JumpToKey("acid"))
	{
		g_ArEvery = kv.GetNum("ArEvery", g_ArEvery);
		g_ArLast = kv.GetNum("ArLast", g_ArLast);
		g_ArDamage = kv.GetNum("ArDamage", g_ArDamage);
		g_ArZombies = kv.GetNum("ArZombies", g_ArZombies ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("airstrike"))
	{
		g_AsEvery = kv.GetNum("AsEvery", g_AsEvery);
		g_AsBombs = kv.GetNum("AsBombs", g_AsBombs);
		g_AsWarn = kv.GetNum("AsWarn", g_AsWarn);
		g_AsDamage = kv.GetNum("AsDamage", g_AsDamage);
		g_AsRadius = kv.GetFloat("AsRadius", g_AsRadius);
		g_AsZombies = kv.GetNum("AsZombies", g_AsZombies ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("blackout"))
	{
		g_BoEvery = kv.GetNum("BoEvery", g_BoEvery);
		g_BoCount = kv.GetNum("BoCount", g_BoCount);
		g_BoLast = kv.GetNum("BoLast", g_BoLast);
		g_BoType = kv.GetNum("BoType", g_BoType);
		g_BoEveryone = kv.GetNum("BoEveryone", g_BoEveryone ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("boss"))
	{
		g_BzHealth = kv.GetNum("BzHealth", g_BzHealth);
		g_BzPerHuman = kv.GetNum("BzPerHuman", g_BzPerHuman);
		g_BzSpeed = kv.GetFloat("BzSpeed", g_BzSpeed);
		g_BzDelay = kv.GetNum("BzDelay", g_BzDelay);
		g_BzReward = kv.GetNum("BzReward", g_BzReward);
		kv.GoBack();
	}
	if (kv.JumpToKey("buddy"))
	{
		g_BdDie = kv.GetNum("BdDie", g_BdDie ? 1 : 0) != 0;
		g_BdBleed = kv.GetNum("BdBleed", g_BdBleed);
		g_BdMaxDist = kv.GetFloat("BdMaxDist", g_BdMaxDist);
		kv.GoBack();
	}
	if (kv.JumpToKey("butter"))
	{
		g_BfEvery = kv.GetNum("BfEvery", g_BfEvery);
		g_BfCount = kv.GetNum("BfCount", g_BfCount);
		g_BfWhich = kv.GetNum("BfWhich", g_BfWhich);
		kv.GoBack();
	}
	if (kv.JumpToKey("cold"))
	{
		g_FcEvery = kv.GetNum("FcEvery", g_FcEvery);
		g_FcLast = kv.GetNum("FcLast", g_FcLast);
		g_FcDamage = kv.GetNum("FcDamage", g_FcDamage);
		g_FcHuddle = kv.GetFloat("FcHuddle", g_FcHuddle);
		g_FcNeed = kv.GetNum("FcNeed", g_FcNeed);
		kv.GoBack();
	}
	if (kv.JumpToKey("darkness"))
	{
		g_SdEvery = kv.GetNum("SdEvery", g_SdEvery);
		g_SdLast = kv.GetNum("SdLast", g_SdLast);
		g_SdLevel = kv.GetNum("SdLevel", g_SdLevel);
		g_SdZombies = kv.GetNum("SdZombies", g_SdZombies ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("doublejump"))
	{
		g_DjBoost = kv.GetFloat("DjBoost", g_DjBoost);
		g_DjJumps = kv.GetNum("DjJumps", g_DjJumps);
		g_DjHumans = kv.GetNum("DjHumans", g_DjHumans ? 1 : 0) != 0;
		g_DjZombies = kv.GetNum("DjZombies", g_DjZombies ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("drop"))
	{
		g_ZdEvery = kv.GetNum("ZdEvery", g_ZdEvery);
		g_ZdCount = kv.GetNum("ZdCount", g_ZdCount);
		g_ZdWarn = kv.GetNum("ZdWarn", g_ZdWarn);
		kv.GoBack();

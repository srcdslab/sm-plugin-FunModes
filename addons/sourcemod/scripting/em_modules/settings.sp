		g_HsTime = kv.GetNum("HsTime", g_HsTime);
		g_HsSource = kv.GetNum("HsSource", g_HsSource);
		g_HsPenalty = kv.GetNum("HsPenalty", g_HsPenalty);
		g_HsReward = kv.GetNum("HsReward", g_HsReward);
		g_HsPlayers = kv.GetNum("HsPlayers", g_HsPlayers);
		g_HsHumansOnly = kv.GetNum("HsHumansOnly", g_HsHumansOnly ? 1 : 0) != 0;
		kv.GoBack();
	}
	if (kv.JumpToKey("ice"))
	{
